{
  "name": "overture_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/.next && rm -rf .next/standalone/.next/static && cp -R .next/static .next/standalone/.next/static",
    "start": "HOSTNAME=${OVERTURE_BIND_HOST:-0.0.0.0} PORT=${PORT:-3000} node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "OVERTURE_ROOT=.overture-e2e PORT=3100 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100 env -u FORCE_COLOR -u NO_COLOR playwright test",
    "qa": "npm run lint && npm run test && npm run build",
    "runner": "tsx scripts/runner.ts",
    "seed": "tsx scripts/seed-project.ts",
    "security:semgrep": "bash scripts/security/run-semgrep.sh",
    "security:trivy": "bash scripts/security/run-trivy.sh",
    "security:zap": "bash scripts/security/run-zap.sh",
    "security": "npm run security:semgrep && npm run security:trivy",
    "deploy:local": "bash deploy.sh local"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphql": "^16.13.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
